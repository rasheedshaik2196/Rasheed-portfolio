*{box-sizing:border-box;margin:0}html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px)}
body{background:var(--bg);color:var(--fg);font-family:'Space Grotesk',system-ui,sans-serif;line-height:1.7;overflow-x:hidden}
a{color:inherit;text-decoration:none}h1,h2,h3{font-family:'Fraunces',Georgia,serif}
#petals{position:fixed;inset:0;pointer-events:none;z-index:5}
nav{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;display:flex;justify-content:space-between;padding:20px 5vw;z-index:20;font-size:.8rem;letter-spacing:.18em;text-transform:uppercase}
nav div{display:flex;gap:24px}nav a{opacity:.75;transition:.3s}nav a:hover{opacity:1;color:var(--pk)}
.hero{min-height:100vh;position:relative;display:flex;flex-direction:column;justify-content:center;padding:130px 6vw 200px;background:linear-gradient(180deg,var(--bg) 0,var(--bg2) 100%);overflow:hidden}
.moon{position:absolute;right:12vw;top:16vh;width:min(20vw,200px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 35% 35%,#fff7f3,var(--pk));opacity:.85;box-shadow:0 0 90px var(--pk);animation:b 10s ease-in-out infinite}
@keyframes b{50%{transform:translateY(-14px)}}
.kanji{position:absolute;right:5vw;bottom:34vh;writing-mode:vertical-rl;font-family:'Fraunces',serif;font-size:1.3rem;letter-spacing:.5em;color:var(--mut);opacity:.7}
.tag{font-size:.78rem;letter-spacing:.35em;text-transform:uppercase;color:var(--pk)}
h1{font-weight:300;font-size:clamp(2.8rem,9vw,7.6rem);line-height:1;letter-spacing:-.02em;margin:22px 0;position:relative;z-index:2}
h1 b{font-weight:600;display:block}h1 em{color:var(--pk)}
.lead{max-width:520px;color:var(--mut);font-size:1.1rem;position:relative;z-index:2}
.mt{position:absolute;left:0;right:0;bottom:-1px;width:100%;height:46vh;min-height:240px;z-index:1}
.cta{display:flex;gap:14px;margin-top:32px;flex-wrap:wrap;position:relative;z-index:3}
.btn{padding:13px 26px;border-radius:99px;border:1px solid var(--pk);font:inherit;font-size:.92rem;cursor:pointer;background:none;color:var(--fg);transition:.3s}
.btn.p{background:var(--ac);border-color:var(--ac);color:#fff}.btn:hover{transform:translateY(-3px);box-shadow:0 8px 28px -8px var(--pk)}
section{position:relative;z-index:2;padding:110px 6vw;background:var(--bg)}
h2{font-weight:400;font-size:clamp(2rem,5vw,3.8rem);line-height:1.1;margin-bottom:30px}h2 em{color:var(--pk)}
.about{display:grid;grid-template-columns:1fr 1fr;gap:6vw}.about p{color:var(--mut);margin-bottom:16px;font-size:1.05rem}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:28px}
.stats div{border:1px solid var(--line);border-radius:16px;padding:18px;background:var(--card)}
.stats b{font-family:'Fraunces',serif;font-weight:400;font-size:2.4rem;color:var(--pk);display:block;line-height:1}.stats small{color:var(--mut)}
.chips{display:flex;flex-wrap:wrap;gap:10px}.chips h4{width:100%;font-weight:500;color:var(--mut);font-size:.75rem;letter-spacing:.3em;text-transform:uppercase;margin:16px 0 0}
.chips span{padding:9px 18px;border:1px solid var(--line);border-radius:99px;background:var(--card);transition:.25s}.chips span:hover{border-color:var(--pk);color:var(--pk)}
.door{display:block;text-align:center;padding:90px 6vw;border:1px solid var(--line);border-radius:28px;background:linear-gradient(160deg,var(--card),var(--bg2));transition:.4s;cursor:pointer}
.door:hover{border-color:var(--pk);transform:translateY(-6px)}.door h2{margin-bottom:12px}.door p{color:var(--mut)}.door span{display:inline-block;margin-top:24px;color:var(--pk);letter-spacing:.2em;text-transform:uppercase;font-size:.85rem}
.contact{text-align:center}.contact a.big{font-family:'Fraunces',serif;font-size:clamp(1.3rem,4.6vw,3rem);border-bottom:1px solid var(--pk);word-break:break-all}
.contact .row{display:flex;gap:14px;justify-content:center;margin-top:30px;flex-wrap:wrap}
footer{padding:30px 6vw;color:var(--mut);text-align:center;border-top:1px solid var(--line);font-size:.85rem;position:relative;z-index:2;background:var(--bg)}
#pv{display:none;min-height:100vh;padding:110px 6vw 60px;position:relative;z-index:2;background:var(--bg)}
.back{background:none;border:0;color:var(--pk);font:inherit;cursor:pointer;letter-spacing:.15em;text-transform:uppercase;font-size:.85rem;margin-bottom:26px}
.bar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:8px 0 28px}.bar .btn{padding:9px 20px}.bar .btn.on{background:var(--pk);color:#1a1424;border-color:var(--pk)}
.bar select{padding:9px 14px;border-radius:99px;background:var(--card);color:var(--fg);border:1px solid var(--line);font:inherit}.sp{flex:1}
.grid{columns:3 280px;column-gap:18px}
.w{break-inside:avoid;margin-bottom:18px;border-radius:16px;overflow:hidden;position:relative;cursor:zoom-in;background:var(--card);border:1px solid var(--line);transition:.4s}
.w:hover{transform:translateY(-5px);border-color:var(--pk)}.w img{width:100%;display:block}
.w figcaption{position:absolute;inset:auto 0 0;padding:40px 16px 14px;background:linear-gradient(transparent,rgba(10,8,20,.85));color:#fff;opacity:0;transition:.3s;font-size:.9rem}
.w:hover figcaption{opacity:1}.w small{display:block;color:var(--pk);letter-spacing:.15em;text-transform:uppercase;font-size:.7rem}
.hint{color:var(--mut);font-size:.85rem;margin-top:8px}
#lb{position:fixed;inset:0;background:rgba(8,6,16,.94);display:none;align-items:center;justify-content:center;z-index:50;padding:5vw;flex-direction:column;gap:12px;cursor:zoom-out}
#lb.o{display:flex}#lb img{max-width:100%;max-height:82vh;border-radius:12px}#lb p{color:#fff}
.rv{opacity:0;transform:translateY(26px);transition:1.1s cubic-bezier(.2,.7,.2,1)}.rv.in{opacity:1;transform:none}
@media(max-width:760px){.about{grid-template-columns:1fr}.kanji{display:none}nav div{gap:14px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style></head><body>
