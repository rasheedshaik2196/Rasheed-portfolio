<style>
:root{--bg:#14141f;--bg2:#2a2540;--fg:#efe7ea;--mut:#a39cab;--card:#1d1c2b;--line:#33304a;--pk:#f2a7b8;--ac:#e8607a;--m1:#2b2a45;--m2:#1f1e34;--m3:#161625;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
