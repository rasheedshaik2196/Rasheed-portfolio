<script>
var works=[
{t:"Discover Japan — Tri-fold Brochure",c:"Photoshop",s:"data:image/jpeg;base64,"},
{t:"Discover Japan — Travel Poster",c:"Photoshop",s:"data:image/jpeg;base64,"},
{t:"Japan Journey — Mobile App Flow",c:"Figma",s:"data:image/jpeg;base64,"},
{t:"Japan — Land of the Rising Sun",c:"Photoshop",s:"data:image/jpeg;base64,"},
{t:"Japan Journey — Web Layout",c:"Figma",s:"data:image/jpeg;base64,"},
{t:"Japanese New Year Party Poster",c:"Photoshop",s:"data:image/jpeg;base64,"},
{t:"Japan Journey — Home Screen",c:"Figma",s:"data:image/jpeg;base64,"},
{t:"Travel Agency for Japan Tour",c:"Photoshop",s:"data:image/jpeg;base64,"},
{t:"Japan Journey — Tour Guide Cover",c:"Photoshop",s:"data:image/jpeg;base64,"},
{t:"Japan Culture — Banner",c:"Photoshop",s:"data:image/jpeg;base64,"}];
var cur="All",$=function(i){return document.getElementById(i)};
function bar(){var cs=["All"];works.forEach(function(w){if(cs.indexOf(w.c)<0)cs.push(w.c)});
$("bar").innerHTML=cs.map(function(c){return '<button class="btn'+(c==cur?' on':'')+'" data-c="'+c+'">'+c+'</button>'}).join('')+'<span class="sp"></span><select id="sel"><option>Photoshop</option><option>Figma</option><option>Animation</option><option>Photography</option><option>Video</option></select><button class="btn p" id="add">+ Add work</button>';
$("bar").querySelectorAll("[data-c]").forEach(function(b){b.onclick=function(){cur=b.dataset.c;bar();grid()}});$("add").onclick=function(){$("f").click()}}
function grid(){$("grid").innerHTML=works.map(function(w,i){return (cur=="All"||w.c==cur)?'<figure class="w" data-i="'+i+'"><img loading="lazy" alt="'+w.t+'" src="'+w.s+'"><figcaption><small>'+w.c+'</small>'+w.t+'</figcaption></figure>':''}).join('');
$("grid").querySelectorAll(".w").forEach(function(f){f.onclick=function(){var w=works[f.dataset.i];$("lb").querySelector("img").src=w.s;$("lb").querySelector("p").textContent=w.t+" · "+w.c;$("lb").classList.add("o")}})}
$("lb").onclick=function(){this.classList.remove("o")};
document.addEventListener("keydown",function(e){if(e.key=="Escape")$("lb").classList.remove("o")});
$("f").onchange=function(e){var c=$("sel").value;Array.prototype.forEach.call(e.target.files,function(f){works.unshift({t:f.name.replace(/\.[^.]+$/,""),c:c,s:URL.createObjectURL(f)})});cur="All";bar();grid();e.target.value=""};
function route(){var h=location.hash.slice(1),p=h=="projects";$("pv").style.display=p?"block":"none";$("hv").style.display=p?"none":"block";
if(p)scrollTo(0,0);else{var el=h&&$(h);if(el)el.scrollIntoView();else scrollTo(0,0)}}
$("bk").onclick=function(){location.hash="home"};
addEventListener("hashchange",route);bar();grid();route();
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("in");e.target.querySelectorAll("[data-n]").forEach(function(n){var t=+n.dataset.n,i=0,x=setInterval(function(){n.textContent=++i;if(i>=t)clearInterval(x)},140)});io.unobserve(e.target)}})},{threshold:.15});
setInterval(function(){document.querySelectorAll(".rv:not(.in)").forEach(function(e){io.observe(e)})},400);
var cv=$("petals"),cx=cv.getContext("2d"),P=[],W,H;function rs(){W=cv.width=innerWidth;H=cv.height=innerHeight}rs();addEventListener("resize",rs);
for(var i=0;i<26;i++)P.push({x:Math.random()*2e3,y:Math.random()*1e3,r:4+Math.random()*6,v:.4+Math.random()*.7,d:Math.random()*6.28,s:Math.random()*.02+.005});
if(!matchMedia("(prefers-reduced-motion:reduce)").matches)(function a(){cx.clearRect(0,0,W,H);P.forEach(function(p){p.y+=p.v;p.d+=p.s;p.x+=Math.sin(p.d)*.8+.3;if(p.y>H+10){p.y=-10;p.x=Math.random()*W}if(p.x>W+10)p.x=-10;cx.save();cx.translate(p.x,p.y);cx.rotate(p.d);cx.fillStyle="rgba(242,167,184,.65)";cx.beginPath();cx.ellipse(0,0,p.r,p.r*.55,0,0,6.28);cx.fill();cx.restore()});requestAnimationFrame(a)})();
</script></body></html>
